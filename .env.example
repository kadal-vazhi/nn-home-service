# ==============================================================================
# Kadal Vazhi — Environment Secrets Template (.env.example)
# INSTRUCTIONS: Copy this file to .env and fill in your real secrets.
# ==============================================================================

# PostgreSQL Database Configuration
DB_NAME=kadalvazhi_core
DB_USER=kadalvazhi_core
DB_PASSWORD=your_secure_db_password_here

# Redis In-Memory Store Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# pgAdmin 4 Web Console Configuration
PGADMIN_EMAIL=admin@kadalvazhi.com
PGADMIN_PASSWORD=your_secure_pgadmin_password_here
